---
import Icon from './Icon.astro';
import type { Service } from '../content/site';

interface Props {
  service: Service;
  detailed?: boolean;
}
const { service, detailed = false } = Astro.props;
---
<article
  class="group relative flex flex-col rounded-card border border-hair bg-white p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-ink-200 hover:shadow-card"
>
  <div class="flex items-start justify-between">
    <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent-50 text-accent-600 transition-colors group-hover:bg-accent-600 group-hover:text-white">
      <Icon name={service.icon} size={22} />
    </span>
    {service.duration && (
      <span class="font-mono text-[11px] uppercase tracking-wider text-ink-500">{service.duration}</span>
    )}
  </div>
  <h3 class="mt-4 text-lg font-semibold tracking-tight text-ink-900">{service.title}</h3>
  <p class="mt-1 text-sm font-medium text-accent-600">{service.short}</p>
  {detailed && <p class="mt-3 text-sm leading-relaxed text-ink-600">{service.description}</p>}
</article>
