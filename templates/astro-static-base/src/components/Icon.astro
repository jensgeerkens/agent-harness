---
/**
 * Inline-SVG-Icons (workerd-/Cloudflare-kompatibel, kein astro-icon).
 * Stroke-basiert, 24x24, currentColor. Pro Projekt erweitern.
 */
interface Props {
  name: string;
  class?: string;
  size?: number;
  'aria-label'?: string;
}
const { name, class: className = '', size = 24, 'aria-label': ariaLabel } = Astro.props;

const paths: Record<string, string> = {
  // UI / Allgemein
  phone:
    '<path d="M5 4h3.2l1.3 4-2 1.4a12 12 0 0 0 5.1 5.1l1.4-2 4 1.3V20a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  'map-pin': '<path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  calendar:
    '<rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 9h16M8 3v4M16 3v4"/>',
  whatsapp:
    '<path d="M4 20l1.4-4A8 8 0 1 1 9 18.6L4 20Z"/><path d="M9.2 9.3c-.2 1 .3 2.3 1.4 3.4s2.4 1.6 3.4 1.4c.5-.1.8-.7.6-1.2l-.4-.9-1.5.5-1.9-1.9.5-1.5-.9-.4c-.5-.2-1.1.1-1.2.6Z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  x: '<path d="M6 6l12 12M18 6 6 18"/>',
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  check: '<path d="m5 12 4.5 4.5L19 7"/>',
  'check-circle': '<circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.4 2.4L16 9.3"/>',
  star: '<path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 17l-5.2 2.6 1-5.8L3.5 9.7l5.9-.9L12 3.5Z"/>',
  award: '<circle cx="12" cy="9" r="5.5"/><path d="m9 13.5-1.5 6.5L12 18l4.5 2-1.5-6.5"/>',
  handshake: '<path d="m11 17 2 2 4-4M3 12l4-4 4 3 2-1 5 4M3 12v4l4 3M21 12V8l-4-2-4 3"/>',
  sparkle: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4"/><path d="M12 8.5 13.2 11 16 12l-2.8 1L12 15.5 10.8 13 8 12l2.8-1L12 8.5Z"/>',
};

const inner = paths[name] ?? '';
const isDecorative = !ariaLabel;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={isDecorative ? 'true' : undefined}
  role={isDecorative ? undefined : 'img'}
  aria-label={ariaLabel}
  set:html={inner}
/>
