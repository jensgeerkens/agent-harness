---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Icon from '../components/Icon.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { company, contact, services, valueProps, testimonials, faq } from '../content/site';

const highlighted = services.filter((s) => s.highlight);
---
<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-hair bg-ink-50/40">
    <div class="grid-motif absolute inset-0 opacity-60" aria-hidden="true"></div>
    <div class="container-page relative grid gap-10 py-20 md:py-28 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <span class="eyebrow">{company.region}</span>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-ink-900 sm:text-5xl lg:text-6xl">
          {company.tagline}
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-600">
          {company.legalName}, {company.foundedSince} für Sie da. Persönlich, verlässlich, regional.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/kontakt" class="btn btn-primary">Kontakt aufnehmen <Icon name="arrow-right" size={18} /></a>
          <a href={contact.phone.link} class="btn btn-ghost">
            <Icon name="phone" size={18} class="text-accent-600" /> {contact.phone.display}
          </a>
          <StatusBadge />
        </div>
      </div>
    </div>
  </section>

  <!-- Value Props -->
  <section class="container-page py-16 md:py-20">
    <div class="grid gap-6 md:grid-cols-3">
      {valueProps.map((vp) => (
        <div class="rounded-card border border-hair bg-white p-6">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent-50 text-accent-600">
            <Icon name={vp.icon} size={22} />
          </span>
          <h2 class="mt-4 text-lg font-semibold text-ink-900">{vp.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-ink-600">{vp.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Leistungen -->
  <section class="container-page py-8 md:py-12">
    <div class="flex items-end justify-between gap-4">
      <div>
        <span class="eyebrow">Leistungen</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900">Das bieten wir an</h2>
      </div>
      <a href="/leistungen" class="hidden text-sm font-semibold text-accent-600 hover:text-accent-700 sm:inline-flex items-center gap-1">
        Alle ansehen <Icon name="arrow-right" size={16} />
      </a>
    </div>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {highlighted.map((s) => <ServiceCard service={s} detailed />)}
    </div>
  </section>

  <!-- Testimonials -->
  {testimonials.length > 0 && (
    <section class="container-page py-16">
      <span class="eyebrow">Stimmen</span>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900">Was andere über uns sagen</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {testimonials.map((t) => (
          <figure class="rounded-card border border-hair bg-white p-6">
            <div class="flex gap-0.5 text-accent-500" aria-label={`${t.rating} von 5 Sternen`}>
              {Array.from({ length: t.rating }).map(() => <Icon name="star" size={18} />)}
            </div>
            <blockquote class="mt-4 text-ink-700">„{t.text}"</blockquote>
            <figcaption class="mt-3 text-sm font-medium text-ink-500">— {t.author}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- FAQ -->
  {faq.length > 0 && (
    <section class="container-page py-12 md:py-16">
      <span class="eyebrow">FAQ</span>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900">Häufige Fragen</h2>
      <div class="mt-8 max-w-3xl divide-y divide-hair rounded-card border border-hair bg-white">
        {faq.map((item) => (
          <details class="group p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-ink-900">
              {item.question}
              <Icon name="chevron-down" size={20} class="shrink-0 text-ink-400 transition-transform group-open:rotate-180" />
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink-600">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  <!-- CTA-Band -->
  <section class="container-page py-12">
    <div class="rounded-card bg-ink-900 px-8 py-12 text-center text-white md:py-16">
      <h2 class="text-3xl font-bold tracking-tight">Bereit, loszulegen?</h2>
      <p class="mx-auto mt-3 max-w-xl text-ink-300">Melden Sie sich, wir freuen uns auf Ihre Anfrage.</p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href="/kontakt" class="btn btn-primary">Kontakt aufnehmen</a>
        <a href={contact.phone.link} class="btn btn-ghost border-white/20 text-white hover:bg-white/10">
          <Icon name="phone" size={18} /> {contact.phone.display}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
