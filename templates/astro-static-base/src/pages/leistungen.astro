---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { services } from '../content/site';
---
<BaseLayout
  title="Leistungen"
  description="Unser Leistungsangebot im Überblick, persönlich, verlässlich, regional."
  path="leistungen"
>
  <section class="container-page py-16 md:py-20">
    <span class="eyebrow">Leistungen</span>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-ink-900 sm:text-5xl">Unser Angebot</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-600">
      Alle Leistungen auf einen Blick. Sie haben eine Frage zu einer bestimmten Leistung?
      Rufen Sie uns einfach an.
    </p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => <ServiceCard service={s} detailed />)}
    </div>
  </section>
</BaseLayout>
