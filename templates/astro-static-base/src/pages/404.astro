---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Seite nicht gefunden" description="Diese Seite existiert nicht." path="404">
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="font-mono text-sm uppercase tracking-[0.2em] text-accent-600">Fehler 404</p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-ink-900 sm:text-5xl">Seite nicht gefunden</h1>
    <p class="mt-4 max-w-md text-ink-600">
      Die gesuchte Seite existiert nicht oder wurde verschoben.
    </p>
    <a href="/" class="btn btn-primary mt-8">
      <Icon name="arrow-right" size={18} /> Zur Startseite
    </a>
  </section>
</BaseLayout>
